    //1 //reverse a String
public String reverse(String str){
   String rev="";
   for(int i=str.length()-1;i>=0;i--){
    rev=rev+str.charAt(i);
   } 
   return rev;
}

//2 //fibonacci series
public static void fibonacciSeries(int n){
    int a=1,b=0;
    System.out.print("Fibonacci series: ");
    for(int i=0;i<n;i++){
        System.out.print(b+" ");
        int c=a+b;
        a=b;
        b=c;
    }
    System.out.println();
}
//3 //count digits in a number
public static void countDigits(int num){
    int count=0;
    while(num!=0){
        num=num/10;
        count++;
    }
    System.out.println("Number of digits: "+count);


}

//4//IsPrime number
public boolean isPrime(int n ){

    if(n<=1)return false;

   
        for(int i=2;i<=n/2;i++){
            if(n%i==0) return false;
        }
    return true;

}

//5//amastrong number
public static boolean isAmastrong(int n){

  int original=n;
  int sum=0;
  while(n!=0){
            int digit=n%10;
            sum=sum+(digit*digit*digit);
            n=n/10;
            }
    if(original==sum)return true;
    else{ 
        return false;
    }

}
//6//GCD of Two number
public static int gcd(int a,int b){
    while(b!=0){
        int reminder=a%b;
        a=b;
        b=reminder;
    }
    return a;

    
}
//7//LCM of two number
public static int lcm(int a  ,int b){
    
    int lcm=(a*b)/gcd(a,b);
    return lcm;

}

